# Copy to .env and fill in what you have. Anything left blank runs on demo data.
# Keys are only read by the server (server/node.ts); they are never sent to the browser.

# ---- AI meal planning (Claude) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# ---- Walmart Affiliate API (walmart.io) ----
# Run `npm run keys:walmart`, upload the public key at walmart.io, then:
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_PATH=keys/walmart_private_key.pem
# ...or paste the PKCS#8 PEM inline with literal \n line breaks:
# WALMART_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Optional: Impact publisher id so product links earn affiliate credit
WALMART_PUBLISHER_ID=

# ---- Kroger Public API (developer.kroger.com) ----
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional: pin a store instead of using the ZIP from Preferences
KROGER_LOCATION_ID=
# Certification sandbox instead of production:
# KROGER_API_BASE=https://api-ce.kroger.com/v1

# ---- Instacart Developer Platform ----
INSTACART_API_KEY=
# development (connect.dev.instacart.tools) or production (connect.instacart.com)
INSTACART_ENV=development

# Force demo data everywhere even when keys are present
# DEMO_MODE=true
# PORT=8787
